{
    "name": "joshua-barbosa/erede-sdk",
    "description": "SDK PHP para a API eRede (Rede) com autenticação OAuth 2.0, integrado ao Laravel.",
    "keywords": ["erede", "rede", "laravel", "pagamento", "payment", "gateway", "sdk"],
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/joshua-barbosa/erede-sdk",
    "authors": [
        {
            "name": "Joshua Barbosa"
        }
    ],
    "support": {
        "issues": "https://github.com/joshua-barbosa/erede-sdk/issues",
        "source": "https://github.com/joshua-barbosa/erede-sdk"
    },
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "guzzlehttp/guzzle": "^7.5",
        "psr/log": "^1.1|^2.0|^3.0",
        "symfony/http-foundation": "^7.0|^8.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.5|^11.0|^12.0",
        "laravel/pint": "^1.13"
    },
    "autoload": {
        "psr-4": {
            "eRede\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "eRede\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "eRede\\Providers\\eRedeServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "lint": "vendor/bin/pint --test",
        "fix": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
